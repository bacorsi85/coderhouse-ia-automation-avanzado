    {
      "parameters": {
        "jsCode": "const src = $('Input de prueba').first().json;\nconst raw = $json.text ?? $json.output ?? $json.response ?? '';\nlet d;\ntry {\n  d = JSON.parse(String(raw).replace(/^```json\\s*/i, '').replace(/```$/, '').trim());\n} catch (e) {\n  d = { intent: 'UNKNOWN', confidence: 0, risk: 'HIGH' };\n}\nconst allowed = ['BILLING', 'TECH_SUPPORT', 'SALES', 'UNKNOWN'];\nconst intent = allowed.includes(d.intent) ? d.intent : 'UNKNOWN';\nconst confidence = Math.max(0, Math.min(1, Number(d.confidence ?? 0)));\nconst risk = ['LOW', 'MEDIUM', 'HIGH'].includes(d.risk) ? d.risk : 'HIGH';\nreturn [{ json: { original_input: src.original_input, session_id: src.session_id, intent, confidence, risk } }];"
      },
