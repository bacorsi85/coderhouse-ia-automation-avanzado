    {
      "parameters": {
        "jsCode": "// Límite duro de 200 caracteres para TTS: limpia markdown, links y emojis y corta en límite de palabra\nconst raw = String($json.output ?? $json.text ?? '').trim();\nlet t = raw.replace(/\\[([^\\]]+)\\]\\([^)]*\\)/g, '$1').replace(/https?:\\/\\/\\S+/g, '').replace(/[*_#`>|]/g, '')\n  .replace(/\\((Manual de soporte|Secci[oó]n(es)?)[^)]*\\)/gi, '').replace(/[^.!?]*\\bsecci[oó]n(es)?\\s*\\d+(\\.\\d+)*(\\s*(y|,)\\s*\\d+(\\.\\d+)*)*[^.!?]*[.!?]?/gi, '').replace(/\\s+([.,;:])/g, '$1').replace(/[\\u{1F300}-\\u{1FAFF}\\u{2600}-\\u{27BF}]/gu, '').replace(/\\s+/g, ' ').trim();\nconst MAX = 200;\nlet truncado = false;\nif (t.length > MAX) {\n  truncado = true;\n  const corte = t.slice(0, MAX);\n  const finOracion = Math.max(corte.lastIndexOf('. '), corte.lastIndexOf('? '), corte.lastIndexOf('! '));\n  t = finOracion > 80 ? corte.slice(0, finOracion + 1) : corte.slice(0, corte.lastIndexOf(' ')).replace(/[,;:]$/, '') + '.';\n}\nif (!t) t = 'No te entendí bien. ¿Me lo repetís en una frase?';\nreturn [{ json: { texto_tts: t, chars: t.length, truncado, chat_id: $('Set - Entrada de voz (descarta audio)').first().json.chat_id } }];"
      },
      "id": "e9e9159e-3f55-4666-92c9-cbb0a502eb6e",
      "name": "Code - Límite duro 200 caracteres",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1520,
        432
      ]
    },
