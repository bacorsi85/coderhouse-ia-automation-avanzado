      "parameters": {
        "jsCode": "\nconst e = $input.first().json;\nconst ex = e.execution || {};\nconst err = (ex.error || (e.trigger && e.trigger.error) || {});\nconst detalle = String(err.message || err.description || 'sin detalle').slice(0, 300);\nconst flujo = (e.workflow && e.workflow.name) || 'flujo desconocido';\nconst texto = '🚨 *Falla en el sistema de soporte* · ' + flujo +\n  '\\n*Paso que falló:* ' + (ex.lastNodeExecuted || '-') +\n  '\\n*Error:* ' + detalle +\n  '\\n*Ejecución:* ' + (ex.id || '-') + (ex.url ? ' · ' + ex.url : '') +\n  '\\nEl caso no se consolidó ni se respondió al local: revisar y reprocesar.';\nreturn [{ json: { texto, flujo, paso: ex.lastNodeExecuted || '', detalle, execution_id: ex.id || '' } }];\n"
      }
    },
