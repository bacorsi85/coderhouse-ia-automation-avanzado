    {
      "id": "8f0b6ed2-5efe-41db-8ac3-216907a5620e",
      "name": "Preparar memoria",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "jsCode": "\nconst inp = $('Recibe pedido de memoria').first().json;\nconst m = $input.first().json || {};\nconst existe = Boolean(m.session_id);\nlet hist = [];\ntry { hist = JSON.parse(m.historial || '[]'); } catch (e) { hist = []; }\nconst contador = Number(m.contador_mensajes || 0);\nif (inp.operacion !== 'guardar') {\n  return [{ json: {\n    operacion: 'leer', existe, session_id: inp.session_id,\n    last_summary: m.resumen || 'Sin memoria previa.',\n    historial_reciente: hist.length ? hist.slice(-3).map((h) => 'Cliente: ' + h.u + ' / Respuesta: ' + h.a).join(' || ') : 'Ninguno',\n    contador_mensajes: contador } }];\n}\nhist.push({ u: String(inp.mensaje || '').slice(0, 500), a: String(inp.respuesta || '').slice(0, 700), t: $now.toISO() });\nhist = hist.slice(-6);\nconst nuevo = contador + 1;\nreturn [{ json: {\n  operacion: 'guardar', existe, session_id: inp.session_id, historial: JSON.stringify(hist),\n  resumen_previo: m.resumen || '', contador_mensajes: nuevo,\n  // Consolidación cada 5 mensajes (regla del M3): el resumen reemplaza al anterior.\n  resumir: nuevo >= 5 && nuevo % 5 === 0 } }];\n"
      }
    },
