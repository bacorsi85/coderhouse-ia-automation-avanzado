      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        120
      ],
      "parameters": {
        "jsCode": "\nconst p = $('Preparar memoria').first().json;\nlet resumen = p.resumen_previo;\nif ($('Resumir sesión').isExecuted) {\n  const o = $('Resumir sesión').first().json.output || {};\n  resumen = JSON.stringify(o);\n}\nreturn [{ json: { ...p, resumen } }];\n"
