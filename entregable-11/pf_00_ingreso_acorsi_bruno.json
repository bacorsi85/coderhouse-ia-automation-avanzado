    {
      "id": "3fd628ad-5a04-4ac3-be42-c4a7901e5e65",
      "name": "Normalizar y validar",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "jsCode": "\nconst req = $input.first().json;\nconst b = req.body || {};\nconst h = req.headers || {};\nconst s = (v) => String(v ?? '').trim();\nconst email = s(b.email).toLowerCase();\nconst mensaje = s(b.mensaje);\nconst asunto = s(b.asunto) || '(sin asunto)';\nconst nombre = s(b.nombre);\nconst canal = s(b.canal) || 'web';\n// Inyección de falla controlada para auditar al supervisor (solo el valor RECHAZAR tiene efecto).\nconst modo_prueba = s(b.modo_prueba).toUpperCase() === 'RECHAZAR' ? 'RECHAZAR' : 'NORMAL';\nconst clave = s(h['idempotency-key'] || b.request_id);\nlet motivo = '';\nif (!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email)) motivo = 'email inválido';\nelse if (mensaje.length < 3) motivo = 'mensaje vacío';\nelse if (mensaje.length > 4000) motivo = 'mensaje demasiado largo (máximo 4000 caracteres)';\n// Clave de idempotencia: la del emisor si la manda; si no, el contenido normalizado.\nconst semilla_idem = clave ? 'key:' + clave\n  : [email, asunto.toLowerCase(), mensaje.toLowerCase().replace(/\\s+/g, ' ')].join('|');\nreturn [{ json: { email, nombre, asunto, mensaje, canal, modo_prueba, valido: !motivo, motivo, semilla_idem } }];\n"
      }
    },
