        0
      ],
      "parameters": {
        "jsCode": "\nconst d = $('Calcular clave de idempotencia').first().json;\nconst trace_id = 'pf-' + $now.toFormat('yyyyMMdd-HHmmss') + '-' + d.idem_key.slice(0, 6);\nreturn [{ json: { trace_id, idem_key: d.idem_key, session_id: d.email, nombre: d.nombre,\n  asunto: d.asunto, mensaje: d.mensaje, canal: d.canal, modo_prueba: d.modo_prueba } }];\n"
      }
